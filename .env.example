# Скопируй этот файл в .env и заполни

# Токен от @BotFather
BOT_TOKEN=

# Ключевая ставка ЦБ в процентах (cbr.ru). Обязательно. Обновляй, когда ЦБ меняет ставку
KEY_RATE=

# Адрес Mini App на GitHub Pages, например https://имя.github.io/zholtok/  (пусто = приложение выключено)
MINIAPP_URL=

# Ссылка на бота для фирменной памятки, например t.me/zholtok_docs_bot
BOT_LINK=

# Ссылка на политику обработки персональных данных
POLICY_URL=
# Контакт поддержки, например @zholtok_support
SUPPORT=
# Твой Telegram ID для команды /stats (через запятую, если несколько)
ADMIN_IDS=
